[Unit]
Description=Betronix Bonus Approval Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user/bot

ExecStart=/home/user/bot/.venv/bin/python -m src.main
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/user

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bonus-bot

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/user/bot /home/user/.cache
PrivateTmp=true

# Resource limits
MemoryMax=1G
TasksMax=64

[Install]
WantedBy=multi-user.target
