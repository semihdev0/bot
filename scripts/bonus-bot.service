[Unit]
Description=Betronix Bonus Approval Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/user/bot

ExecStart=/home/user/bot/venv/bin/python -m src.main
Restart=always
RestartSec=10
StartLimitIntervalSec=600
StartLimitBurst=10

Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/user

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bonus-bot

# Resource limits
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=multi-user.target
